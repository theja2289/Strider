{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["../shared/*"] },
    "types": ["@react-three/fiber"]
  },
  "include": ["src", "../shared", "remotion.config.ts"]
}
